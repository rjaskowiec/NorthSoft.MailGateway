# Example local development variables for Cloudflare Wrangler (npx wrangler dev)
# Copy this file to .dev.vars for local testing. NEVER commit .dev.vars to version control.

GATEWAY_TOKEN=your-gateway-token-here
BREVO_API_KEY=your-brevo-api-key-here
AUTHORIZED_SENDERS=no-reply@example.com,support@example.com
